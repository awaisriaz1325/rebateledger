{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./backend/.env)",
      "Read(./frontend/.env)",
      "Read(./frontend/.env.local)",
      "Read(./.env.production)",
      "Read(./infra/terraform.tfvars)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gcloud *)",
      "Bash(gsutil *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(docker push *)",
      "Bash(alembic downgrade *)"
    ]
  }
}
