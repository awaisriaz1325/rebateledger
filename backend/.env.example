# Backend settings for local development (copy to backend/.env or export them).
# Dummy values only. Real values live in Secret Manager in cloud environments.
RL_ENV=local
RL_APP_BASE_URL=http://localhost:3000
RL_DATABASE_URL=postgresql+psycopg://rl_app:local-app-pw@localhost:5442/rebateledger
RL_MIGRATION_DATABASE_URL=postgresql+psycopg://rl_owner:local-owner-pw@localhost:5442/rebateledger
RL_REDIS_URL=redis://localhost:6382/0
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RL_TOTP_ENCRYPTION_KEY=ZmFrZS1sb2NhbC1rZXktZm9yLWRldi1vbmx5LTAwMDA=
RL_SIGNING_KEY=local-dev-signing-key-change-me-0123456789abcdef
RL_SMTP_HOST=localhost
RL_SMTP_PORT=1026
RL_STORAGE_DIR=var/storage
