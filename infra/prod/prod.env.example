# Copy to /var/lib/rebateledger/prod.env on the VM (owner root, chmod 600). DUMMY values only.
# The release tag is not set here: infra/prod/deploy.sh passes it.
# Secrets: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Fernet key: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
POSTGRES_PASSWORD=change-me
RL_OWNER_PASSWORD=change-me
RL_APP_PASSWORD=change-me
REDIS_PASSWORD=change-me-redis-password
RL_DATABASE_URL=postgresql+psycopg://rl_app:change-me@postgres:5432/rebateledger
RL_MIGRATION_DATABASE_URL=postgresql+psycopg://rl_owner:change-me@postgres:5432/rebateledger
# Same value as REDIS_PASSWORD below (Redis requires it).
RL_REDIS_URL=redis://:change-me-redis-password@redis:6379/0
# One host serves the app and the public pages (founder, 2026-11-20).
RL_APP_BASE_URL=https://rebateledger.imageme.tech
RL_TRUSTED_ORIGINS=[]
RL_SIGNING_KEY=change-me-to-at-least-32-random-characters
RL_TOTP_ENCRYPTION_KEY=change-me
RL_SMTP_HOST=smtp.example.invalid
RL_SMTP_PORT=587
RL_SMTP_USERNAME=change-me
RL_SMTP_PASSWORD=change-me
RL_SMTP_STARTTLS=true
RL_EMAIL_FROM=RebateLedger <no-reply@example.invalid>
RL_OPS_NOTIFY_EMAIL=ops@example.invalid
RL_PLATFORM_ADMIN_IP_ALLOWLIST=[]
BACKUP_BUCKET=example-rebateledger-backups
CLOUD_CLI_IMAGE=gcr.io/google.com/cloudsdktool/google-cloud-cli:PIN-EXACT-VERSION-slim
